Name:           udnf
Version:        0.1.0
Release:        1%{?dist}
Summary:        Rootless userland package manager built on libdnf5
License:        GPL-2.0-or-later
URL:            https://github.com/pierrepinon/udnf
# Generated by scripts/build-rpm.sh: sources, and the vendored crates for offline builds.
Source0:        %{name}-%{version}.tar.gz
Source1:        %{name}-%{version}-vendor.tar.xz

# The gnome-software plugin is built with meson from its own directory.
%global _vpath_srcdir gnome-software-plugin
%global _vpath_builddir build-gnome-software
# Plugins are dlopen'ed by gnome-software: nothing to provide.
%global __provides_exclude_from ^%{_libdir}/gnome-software/plugins-.*/.*\\.so$

BuildRequires:  cargo
BuildRequires:  rust
BuildRequires:  gcc-c++
BuildRequires:  pkgconfig(libdnf5)
BuildRequires:  pkgconfig(rpm)
BuildRequires:  meson
BuildRequires:  gcc
BuildRequires:  pkgconfig(gnome-software)

%description
udnf installs RPM packages into the user's home directory without root privileges, using
libdnf5 for repositories and dependency resolution. Packages already provided by the system
are reused; only the missing dependencies are installed. Programs are exposed through
wrappers in ~/.local/bin, desktop entries and icons, with no shell configuration needed.

%package gnome-software
Summary:        GNOME Software plugin for udnf
Requires:       %{name}%{?_isa} = %{version}-%{release}
Requires:       gnome-software%{?_isa}
Supplements:    (%{name} and gnome-software)

%description gnome-software
Offers the applications of the system AppStream catalog in GNOME Software as user-scope
alternatives ("udnf (utilisateur)"): install, remove, launch and update them without root.
The plugin is tied to the GNOME Software plugin API it was built against.

%prep
%autosetup -n %{name}-%{version} -a 1
mkdir -p .cargo
cat > .cargo/config.toml <<'CARGO'
[source.crates-io]
replace-with = "vendored-sources"

[source.vendored-sources]
directory = "vendor"
CARGO

%build
export RUSTFLAGS="%{?build_rustflags}"
cargo build --release --offline --locked
%meson
%meson_build

%install
install -Dm755 target/release/udnf %{buildroot}%{_bindir}/udnf
%meson_install

%check
cargo test --release --offline --locked

%files
%license LICENSE
%doc README.md
%{_bindir}/udnf

%files gnome-software
%license LICENSE
%{_libdir}/gnome-software/plugins-*/libgs_plugin_udnf.so

